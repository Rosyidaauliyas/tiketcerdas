# ---- Pilih mode dengan LLM_PROVIDER ----
#  mock          = tanpa API key, aturan kata kunci (untuk demo cepat / tes)
#  openai_compat = LLM sungguhan lewat API gratis (Groq atau Google Gemini)
#  anthropic     = Claude API (berbayar)
LLM_PROVIDER=mock

# ---- Untuk openai_compat: contoh Groq (gratis, tanpa kartu kredit) ----
# Key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---- Alternatif Gemini (gratis, Google AI Studio: https://aistudio.google.com/apikey) ----
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# ---- Untuk anthropic ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

DB_PATH=tickets.db
